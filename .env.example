# Local development environment. Do NOT commit real secrets.

# --- Database ---
DATABASE_URL="postgresql://USER:PASS@HOST:5432/DB?schema=public"

# --- Auth (Phase 1) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# --- SMS / phone OTP (Phase 1) ---
# Leave blank in dev to use the console stub sender.
SMS_PROVIDER="stub"
SMS_API_KEY=""
SMS_SENDER_ID="Paltar"

# --- Object storage / images (Phase 2) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="paltar-images"
R2_PUBLIC_BASE_URL=""

# --- Payments / Lemon Squeezy (Phase 8) ---
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
