// Paltar data model. See CONTEXT.md for domain language and PLAN.md for the plan.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  REGULAR
  STORE
  ADMIN
}

enum Department {
  MEN
  WOMEN
  KIDS
  UNISEX
}

enum Category {
  OUTERWEAR
  TOPS
  BOTTOMS
  DRESSES
  FOOTWEAR
  ACCESSORIES
  ACTIVEWEAR
  OTHER
}

enum Condition {
  NEW
  USED
}

// Listing lifecycle. See CONTEXT.md "Listing state".
enum ListingState {
  PENDING
  ACTIVE
  INACTIVE
  SOLD
  REJECTED
}

// Storefront branding review state.
enum BrandingState {
  PENDING
  APPROVED
  REJECTED
}

enum PromotionTier {
  VIP
  DIAMOND
}

enum ReportTargetType {
  LISTING
  STORE
  USER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum PaymentKind {
  STORE_UPGRADE
  PROMOTION
  STORE_AD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OtpPurpose {
  REGISTER
  LOGIN
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

// A User is identified by EITHER email (+passwordHash) OR phone (+OTP).
// The "either/or" rule is enforced in application code, not the schema.
model User {
  id            String    @id @default(cuid())
  role          Role      @default(REGULAR)
  email         String?   @unique
  passwordHash  String?
  phone         String?   @unique
  phoneVerified Boolean   @default(false)
  emailVerified DateTime?
  displayName   String?
  bannedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  storeProfile          StoreProfile?
  listings              Listing[]
  payments              Payment[]
  conversationsAsBuyer  Conversation[] @relation("BuyerConversations")
  conversationsAsSeller Conversation[] @relation("SellerConversations")
  messages              Message[]
  reportsMade           Report[]       @relation("ReportsMade")

  @@index([role])
}

// Storefront for a Store user. Branding (name/logo/bio) is reviewed before going public.
model StoreProfile {
  id              String        @id @default(cuid())
  userId          String        @unique
  name            String
  slug            String        @unique
  logoUrl         String?
  bio             String?
  brandingState   BrandingState @default(PENDING)
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeAds StoreAd[]

  @@index([brandingState])
}

// ---------------------------------------------------------------------------
// Listings
// ---------------------------------------------------------------------------

model Listing {
  id              String       @id @default(cuid())
  ownerId         String
  title           String
  description     String
  department      Department
  category        Category
  brand           String?
  size            String
  condition       Condition
  priceMinor      Int // AZN minor units (qəpik)
  negotiable      Boolean      @default(false)
  city            String
  contactPhone    String
  state           ListingState @default(PENDING)
  rejectionReason String?
  approvedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images        ListingImage[]
  promotions    Promotion[]
  conversations Conversation[]

  @@index([ownerId])
  @@index([state])
  @@index([department, category])
  @@index([createdAt])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  url       String
  position  Int
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
}

// ---------------------------------------------------------------------------
// Monetization
// ---------------------------------------------------------------------------

// A time-limited paid boost on a Listing. Active when startsAt <= now < expiresAt.
model Promotion {
  id        String        @id @default(cuid())
  listingId String
  tier      PromotionTier
  startsAt  DateTime      @default(now())
  expiresAt DateTime
  paymentId String?
  createdAt DateTime      @default(now())

  listing Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([listingId])
  @@index([tier, expiresAt])
}

// A paid slot in the homepage Top Stores panel. Active when startsAt <= now < expiresAt.
model StoreAd {
  id             String   @id @default(cuid())
  storeProfileId String
  startsAt       DateTime @default(now())
  expiresAt      DateTime
  paymentId      String?
  createdAt      DateTime @default(now())

  storeProfile StoreProfile @relation(fields: [storeProfileId], references: [id], onDelete: Cascade)
  payment      Payment?     @relation(fields: [paymentId], references: [id])

  @@index([expiresAt])
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  kind           PaymentKind
  amountMinor    Int
  currency       String        @default("AZN")
  lemonSqueezyId String?       @unique
  status         PaymentStatus @default(PENDING)
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotions Promotion[]
  storeAds   StoreAd[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Chat
// ---------------------------------------------------------------------------

// A conversation is anchored to a Listing, between one buyer and the listing's seller.
model Conversation {
  id            String   @id @default(cuid())
  listingId     String
  buyerId       String
  sellerId      String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Moderation
// ---------------------------------------------------------------------------

model Report {
  id         String           @id @default(cuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     String
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  reporter User @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Auth helpers
// ---------------------------------------------------------------------------

// Short-lived phone OTP challenges. The code itself is stored hashed.
model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([phone])
}
